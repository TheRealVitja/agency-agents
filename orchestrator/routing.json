    {"tag": "ci", "kind": "concern", "agents": ["devops-automator"], "files": [".github/workflows/", ".gitlab-ci.yml", "Jenkinsfile", ".circleci/"], "keywords": ["ci", "pipeline", "workflow", "github actions", "build"]},
