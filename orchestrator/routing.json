{
  "_note": "Which agent takes which part of a project. `tags` are matched against each component the analyzer finds: `deps` against its declared package dependencies (fnmatch patterns, case-insensitive, any ecosystem), `files` against its file paths (a pattern without '/' matches a basename, one ending in '/' a directory, anything else a path relative to the component), `languages` against its main languages. Order is priority: the first matching `platform` tag decides who implements a component, so specific stacks come before general ones. `concern` tags never implement a component on their own; when the task text hits one of their `keywords`, their agent works on the component first (a schema change before the API that uses it). `intents` add read-only steps for the whole task. Every agent here must be a slug from the roster; orchestrator/tests check that.",
  "tags": [
    {"tag": "unreal", "kind": "platform", "agents": ["unreal-systems-engineer"], "files": ["*.uproject", "*.uplugin"]},
    {"tag": "godot", "kind": "platform", "agents": ["godot-gameplay-scripter"], "files": ["project.godot", "*.gd"]},
    {"tag": "unity", "kind": "platform", "agents": ["unity-architect"], "files": ["ProjectSettings/ProjectVersion.txt", "*.unity"]},
    {"tag": "blender-addon", "kind": "platform", "agents": ["blender-add-on-engineer"], "files": ["blender_manifest.toml"]},
    {"tag": "solidity", "kind": "platform", "agents": ["solidity-smart-contract-engineer"], "files": ["*.sol", "foundry.toml", "hardhat.config.*"], "deps": ["hardhat", "@openzeppelin/contracts", "forge-std"]},
    {"tag": "harmonyos", "kind": "platform", "agents": ["harmonyos-app-engineer"], "files": ["oh-package.json5", "*.ets"]},
    {"tag": "wechat-mini-program", "kind": "platform", "agents": ["wechat-mini-program-developer"], "files": ["app.wxss", "project.config.json", "*.wxml"]},
    {"tag": "mobile", "kind": "platform", "agents": ["mobile-app-builder"], "files": ["pubspec.yaml", "AndroidManifest.xml", "*.xcodeproj/", "Podfile", "app.json"], "deps": ["react-native", "expo", "flutter", "@capacitor/core", "@ionic/*", "nativescript*"]},
    {"tag": "embedded", "kind": "platform", "agents": ["embedded-firmware-engineer"], "files": ["platformio.ini", "*.ino", "sdkconfig", "prj.conf"], "deps": ["zephyr", "esp-idf*", "embassy-*", "cortex-m*"]},
    {"tag": "ros2", "kind": "platform", "agents": ["ros-2-robotics-engineer"], "files": ["package.xml"], "deps": ["rclpy", "rclcpp", "ament_*"]},
